
<!DOCTYPE html>
<html>
<head>

    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

    <script src="/javascripts/searchBarScript.js"></script>

    <link rel="stylesheet" href="/stylesheets/style.css" type="text/css">



    <script type="text/javascript" src="/javascripts/footer.js"></script>

    <script type="text/javascript">function FbotonOn() {


                document.getElementById('messageRed').innerHTML = "log in or register";


        }

        function displayMessage() {


            document.getElementById('messageSave').innerHTML = "book saved to list";


        }
    </script>

    <script type="text/javascript">

        $(function () {
            $("#bookLists").change(function () {
                if ($(this).val() === "5") {
                    $('#New').show().focus();
                }else{
                    $('#New').val('').hide();
                }
            });
        });
    </script>

    <title>FileZombie</title>


    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">







    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <link href="https://fonts.googleapis.com/css?family=Alegreya+Sans|EB+Garamond|Encode+Sans+Expanded|Inconsolata|Karla|Manuale|Nunito+Sans|Pontano+Sans|Roboto+Slab:300|Rokkitt|Sanchez" rel="stylesheet">



</head>
<body>

<div class="header">
    <div class="nav-left">
        <a href="/home">Home</a>
        <% if (isAuthenticated) { %>
            <a class="nav-item nav-link" href="/profile">Profile</a>
            <form method="POST" action="/logout">
                <button type="submit" class="btn btn-link nav-item nav-link">Logout</button>
            </form>
        <% } else { %>
            <a class="nav-item nav-link" href="/login">Log in/Register</a>
        <% } %>
        <div class="terms-privacy">
            By logging in, or creating an account, you agree to FileZombie
            <a href="/terms">Terms</a> /
            <a href="/privacy">Privacy Policy</a>
        </div>
    </div>


<div id="nav"></div>





    <main class="book-profile-page">

        <h1>Book Profile</h1>

        <div class="book-profile">

            <div class="book-profile-cover">
                <img
                        src="<%= book_image %>"
                        alt="<%= book_title %>"
                        class="profile-book-image"
                        onerror="this.onerror=null; this.src='/images/no-cover.png';"
                >
            </div>

            <div class="book-details">

                <h2><%= book_title %></h2>

                <p class="book-author">by <%= book_author %></p>

                <div class="book-metadata">
                    <% if (book_isbnTen) { %>
                        <p><strong>ISBN-10:</strong> <%= book_isbnTen %></p>
                    <% } %>

                    <% if (book_isbnThirteen) { %>
                        <p><strong>ISBN-13:</strong> <%= book_isbnThirteen %></p>
                    <% } %>

                    <% if (book_pageCount) { %>
                        <p><strong>Page Count:</strong> <%= book_pageCount %></p>
                    <% } %>

                    <% if (book_printType) { %>
                        <p><strong>Book Type:</strong> <%= book_printType %></p>
                    <% } %>
                </div>

                <% if (book_description) { %>
                    <div class="book-description-section">
                        <h3>Description</h3>

                        <div id="bookDescription" class="book-description collapsed">
                            <%= book_description %>
                        </div>

                        <button
                                type="button"
                                id="descriptionToggle"
                                class="description-toggle"
                                onclick="toggleDescription()"
                        >
                            Show more
                        </button>
                    </div>
                <% } %>

            </div>

            <div class="book-profile-actions">

                <% if (isAuthenticated) { %>

                    <form
                            method="post"
                            action="/fileExpress/<%= encodeURIComponent(book_title) %>&<%= encodeURIComponent(book_author) %>"
                            target="hiddenFrame"
                            onsubmit="displayMessage()"
                            class="book-list-form"
                    >

                        <select id="bookLists" name="list" required>
                            <option selected disabled>Please select a list...</option>
                            <option value="read">read</option>
                            <option value="currently reading">currently reading</option>
                            <option value="want to read">want to read</option>
                            <option value="5">new</option>
                        </select>

                        <input
                                type="text"
                                id="New"
                                name="New"
                                placeholder="New list name"
                                style="display:none"
                        >

                        <button type="submit">Save to list</button>

                        <input type="hidden" name="image" value="<%= book_image %>">

                    </form>


                    <%
                        const standardLists = [
                            "read",
                            "currently reading",
                            "want to read"
                        ];

                        const customLists = Array.isArray(addList)
                                ? addList.filter(function(b) {
                                    return !standardLists.includes(b.list_name);
                                })
                                : [];
                    %>

                    <% if (customLists.length > 0) { %>

                        <form
                                method="post"
                                action="/fileExpress/<%= encodeURIComponent(book_title) %>&<%= encodeURIComponent(book_author) %>"
                                target="hiddenFrame"
                                onsubmit="displayMessage()"
                                class="book-list-form"
                        >

                            <select id="addLists" name="moreList" required>
                                <option selected disabled>More lists...</option>

                                <% customLists.forEach(function(b) { %>
                                    <option value="<%= b.list_name %>">
                                        <%= b.list_name %>
                                    </option>
                                <% }) %>
                            </select>

                            <button type="submit">Save to list</button>

                            <input type="hidden" name="image" value="<%= book_image %>">

                        </form>

                    <% } %>

                    <p id="messageSave"></p>


                <% } else { %>

                    <form
                            onsubmit="FbotonOn(); return false;"
                            class="book-list-form"
                    >

                        <select id="bookLists" name="list" required>
                            <option selected disabled>Please select a list...</option>
                            <option value="read">read</option>
                            <option value="currently reading">currently reading</option>
                            <option value="want to read">want to read</option>
                            <option value="5">new</option>
                        </select>

                        <input
                                type="text"
                                id="New"
                                name="New"
                                placeholder="New list name"
                                style="display:none"
                        >

                        <button type="submit">Save to list</button>

                        <p id="messageRed"></p>

                    </form>

                <% } %>

            </div>



        </div>


        <iframe name="hiddenFrame" class="hide"></iframe>



    </main>


<div id = "footer">

</div>

    <script>
        function toggleDescription() {
            const description = document.getElementById("bookDescription");
            const button = document.getElementById("descriptionToggle");

            if (description.classList.contains("collapsed")) {
                description.classList.remove("collapsed");
                button.textContent = "Show less";
            } else {
                description.classList.add("collapsed");
                button.textContent = "Show more";
            }
        }
    </script>

<!-- Your web-app is https, so your scripts need to be too -->









<!--<script src="/public/javascripts/shorten.js"></script> -->
</body>
</html>