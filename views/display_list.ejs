
<!DOCTYPE html>
<html>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<link rel="stylesheet" href="/stylesheets/style.css" type="text/css">
<link rel="stylesheet" href="/stylesheets/home.css" type="text/css">
<link href="https://fonts.googleapis.com/css?family=Alegreya+Sans|EB+Garamond|Encode+Sans+Expanded|Inconsolata|Karla|Manuale|Nunito+Sans|Pontano+Sans|Roboto+Slab:300|Rokkitt|Sanchez" rel="stylesheet">


<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

<script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

<script src="/javascripts/searchBarScript.js"></script>

<script type="text/javascript" src="/javascripts/footer.js"></script>





<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FileZombie Book List</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .pagination button {
            padding: 8px;
            cursor: pointer;
        }
    </style>
</head>
<body>


<div class="header">

    <a href="/home">Home</a>
    <% if (isAuthenticated) { %>
        <a class="nav-item nav-link" href="/profile">Profile</a>
        <br>
        <br>
        <form method="POST" action="/logout">
            <button type="submit" class="btn btn-link nav-item nav-link">Logout</button>
        </form>

    <% } else { %>
        <div class="login-container">
            <a class="nav-item nav-link" href="/login">Log in/Register</a>
            <div class="terms-text">
                By logging in, or creating an account, you agree to FileZombie
                <a href="/terms">Terms</a> /
                <a href="/privacy">Privacy Policy</a>
            </div>
        </div>

    <% }%>

    <br>

    <div id="nav"></div>
</div>


<div class="display-list-layout">

    <aside class="list-sidebar">
        <h3>My Lists</h3>

        <% userContext.lists.forEach(function(list) { %>

            <% if (list === listName) { %>
                <div class="list-link current-list">
                    <%= list %>
                </div>
            <% } else { %>
                <a
                        class="list-link"
                        href="/display_list/<%= encodeURIComponent(list) %>"
                >
                    <%= list %>
                </a>
            <% } %>

        <% }); %>
    </aside>

    <main class="content">

        <h1 class="list-page-title"><%= listName %></h1>

        <% if (movedBook && destination) { %>
            <p>
                <strong><%= movedBook %></strong>
                was moved to
                <strong><%= destination %></strong>.
            </p>
        <% } %>

        <div id="seeResults">








        <table id="bookTable">
            <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Book Image</th>
                <th>Date Finished</th>
                <th>Date Added</th>
                <th>Current List</th>
                <th>Move to</th>
                <th>Remove</th>

            </tr>
            </thead>
            <tbody id="bookTableBody">
            <% list_books.forEach(function(b) { %>
                <tr class="book-list-card">

                    <td class="book-title-cell">
                        <%= b.book_name %>
                    </td>

                    <td class="book-author-cell">
                        <%= b.book_author %>
                    </td>

                    <td class="book-cover-cell">
                        <% if (b.book_name !== undefined && b.book_author !== undefined) { %>

                        <form method="post"
                              action="/book_profile/<%=b.book_name%>&<%=b.book_author%>">

                            <input
                                    class="list-book-cover"
                                    type="image"
                                    src="<%= b.book_image || '/images/no-cover.png' %>"
                                    alt="<%= b.book_name %>"
                                    onerror="this.onerror=null; this.src='/images/no-cover.png';"
                            >

                        </form>

                        <% } %>
                    </td>

                    <td class="date-finished-cell" id="dateFinished-<%= b.book_name %>">

                        <span class="mobile-field-label">Date finished</span>

                        <%= b.date_finished.toLocaleDateString() %>

                        <form id="changeDateForm-<%= b.book_name %>"
                              data-list-name="<%= listName %>"
                              data-book-name="<%= b.book_name %>"
                              onsubmit="return changeDate(this.dataset.listName, this.dataset.bookName);">

                            <input type="date" name="newDate" required>
                            <button type="submit">Change Date</button>
                        </form>
                    </td>

                    <td class="date-added-cell">
                        <span class="mobile-field-label">Date added</span>
                        <%= b.date_added.toLocaleDateString() %>
                    </td>

                    <td class="current-list-cell">
                        <span class="mobile-field-label">Current list</span>
                        <%= b.list_name %>
                    </td>

                    <td class="move-book-cell">

                        <span class="mobile-field-label">Move to</span>

                        <form method="post"
                              action="/moveBook/<%= b.list_name %>&<%= b.book_name %>&<%= b.book_author%>">

                            <select name="targetList" class="move-list-select">
                                <% userContext.lists.forEach(function(list) { %>
                                    <% if (list !== b.list_name) { %>
                                        <option value="<%= list %>"><%= list %></option>
                                    <% } %>
                                <% }); %>

                                <option value="__new__">New list...</option>
                            </select>

                            <input
                                    type="text"
                                    name="newListName"
                                    class="new-list-name-input"
                                    placeholder="New list name"
                                    style="display: none;"
                            >

                            <button type="submit">Move</button>
                        </form>
                    </td>

                    <td class="remove-book-cell">
                        <form method="post"
                              action="/deleteBook/<%=listName%>&<%=b.book_name%>"
                              onsubmit="return confirm('Do you really want to remove the book?');">

                            <button type="submit"
                                    class="btn btn-link nav-item nav-link">
                                Remove
                            </button>
                        </form>
                    </td>

                </tr>
            <% }); %>
            </tbody>
        </table>







            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="?page=1">First</a>
                    <a href="?page=<%= currentPage - 1 %>">Previous</a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>">Next</a>
                    <a href="?page=<%= totalPages %>">Last</a>
                <% } %>
            </div>

        </div> <!-- closes #seeResults -->

    </main> <!-- closes .content -->

</div> <!-- closes .display-list-layout -->

<div id="footer"></div>

<script>
    function changeDate(listName, bookName) {
        const form = document.getElementById(`changeDateForm-${bookName}`);
        const formData = new FormData(form);
        const newDate = formData.get('newDate');
        if (confirm('Do you want to change date?')) {
            $.ajax({
                url: `/changeDate/${listName}&${bookName}`,
                type: 'POST',
                data: { newDate: newDate },
                success: function(response) {
                    if (response.success) {
                        // Adjust the date to account for time zone differences
                        const adjustedDate = new Date(newDate);
                        adjustedDate.setMinutes(adjustedDate.getMinutes() + adjustedDate.getTimezoneOffset());
                        // Update the date in the table and keep the form
                        document.getElementById(`dateFinished-${bookName}`).innerHTML = `
                        <div>${adjustedDate.toLocaleDateString()}</div>
                        <form id="changeDateForm-${bookName}" onsubmit="return changeDate('${listName}', '${bookName}');">
                            <input type="date" name="newDate" required>
                            <button type="submit">Change Date</button>
                        </form>`;
                    } else {
                        alert('Error updating date: ' + response.message);
                    }
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    alert('Error updating date: ' + xhr.responseText + ' - ' + thrownError);
                }
            });
        }
        return false; // Prevent the form from submitting the traditional way
    }
</script>

<script>
    document.addEventListener("change", function (event) {

        if (!event.target.classList.contains("move-list-select")) {
            return;
        }

        const form = event.target.closest("form");
        const newListInput = form.querySelector(".new-list-name-input");

        if (event.target.value === "__new__") {
            newListInput.style.display = "block";
            newListInput.required = true;
            newListInput.focus();
        } else {
            newListInput.style.display = "none";
            newListInput.required = false;
            newListInput.value = "";
        }
    });
</script>



<nav class="mobile-bottom-nav">
    <a href="/home" class="mobile-nav-item">
        <span>Home</span>
    </a>

    <a href="/profile" class="mobile-nav-item">
        <span>My Lists</span>
    </a>

    <a href="#nav" class="mobile-nav-item" id="mobileSearchLink">
        <span>Search</span>
    </a>

    <a href="/profile" class="mobile-nav-item">
        <span>Profile</span>
    </a>

    <a href="#" class="mobile-nav-item">
        <span>More</span>
    </a>
</nav>

<script>
    document.getElementById("mobileSearchLink")?.addEventListener("click", function (event) {
        event.preventDefault();

        const searchInput = document.getElementById("findBook");

        if (searchInput) {
            searchInput.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

            setTimeout(function () {
                searchInput.focus();
            }, 300);
        }
    });
</script>

</body>

</html>