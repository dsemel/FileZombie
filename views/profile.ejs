<!DOCTYPE html>
<html>
<head>

    <!-- Your web-app is https, so your scripts need to be too -->




    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>

    <script src="/javascripts/searchBarScript.js"></script>
    <link rel="stylesheet" href="/stylesheets/style.css" type="text/css">



    <script type="text/javascript" src="/javascripts/footer.js"></script>



    <!--<script src="/public/javascripts/shorten.js"></script> -->
    <title>FileZombie</title>


    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="stylesheet" href="/style.css" type="text/css">
    <link rel="stylesheet" href="/home.css" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Alegreya+Sans|EB+Garamond|Encode+Sans+Expanded|Inconsolata|Karla|Manuale|Nunito+Sans|Pontano+Sans|Roboto+Slab:300|Rokkitt|Sanchez" rel="stylesheet">
</head>
<body>

<div class="profile-header">

    <div id="nav"></div>

    <div class="profile-desktop-links">
        <a href="/home">Home</a>

        <form method="POST" action="/logout">
            <button type="submit">Logout</button>
        </form>
    </div>

</div>


<main class="profile-page">

    <div class="profile-title">
        <h1>My Lists</h1>
        <p>Welcome <%= name %></p>
    </div>

    <%
    const defaultLists = [
        "read",
        "currently reading",
        "want to read"
    ];

    const customLists = addList.filter(function(b) {
        return !defaultLists.includes(b.list_name);
    });
    %>

    <section class="profile-lists">

        <h2>Your Books</h2>

        <form method="post" action="/display_list/" class="list-row">
            <input type="hidden" name="list" value="currently reading">
            <button type="submit" class="list-row-button">
                <span>Currently Reading</span>
                <span class="list-arrow">›</span>
            </button>
        </form>

        <form method="post" action="/display_list/" class="list-row">
            <input type="hidden" name="list" value="want to read">
            <button type="submit" class="list-row-button">
                <span>Want to Read</span>
                <span class="list-arrow">›</span>
            </button>
        </form>

        <form method="post" action="/display_list/" class="list-row">
            <input type="hidden" name="list" value="read">
            <button type="submit" class="list-row-button">
                <span>Read</span>
                <span class="list-arrow">›</span>
            </button>
        </form>


        <% if (customLists.length > 0) { %>

            <h3 class="custom-lists-heading">Your Lists</h3>

            <% customLists.forEach(function(b) { %>

                <form method="post" action="/display_list/" class="list-row">

                    <input
                            type="hidden"
                            name="list"
                            value="<%= b.list_name %>"
                    >

                    <button type="submit" class="list-row-button">
                        <span><%= b.list_name %></span>
                        <span class="list-arrow">›</span>
                    </button>

                </form>

            <% }); %>

        <% } %>

        <% if (emptyMessage) { %>
            <p class="profile-empty-message">
                <%= emptyMessage %>
            </p>
        <% } %>

    </section>






        <% if (emptyMessage) { %>
            <p class="profile-empty-message">
                <%= emptyMessage %>
            </p>
        <% } %>

    </section>

</main>


<div id="footer"></div>


<div class="mobile-bottom-nav">

    <a href="/home">Home</a>

    <a href="/profile">My Lists</a>

    <a href="#" id="mobileSearchLink">Search</a>

    <a href="/profile">Profile</a>

    <a href="/contact">More</a>

</div>


<script>
    document.addEventListener("click", function (event) {

        if (event.target.id === "mobileSearchLink") {

            event.preventDefault();

            const searchInput =
                document.getElementById("findBook");

            if (searchInput) {

                searchInput.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                setTimeout(function () {
                    searchInput.focus();
                }, 300);

            }
        }
    });
</script>

</body>
</html>
