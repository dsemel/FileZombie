<!DOCTYPE html>
<html>
<head>
    <title>FileZombie</title>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <link rel="stylesheet" href="/stylesheets/style.css" type="text/css">
    <link rel="stylesheet" href="/style.css" type="text/css">
    <link rel="stylesheet" href="/home.css" type="text/css">

    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script src="/javascripts/searchBarScript.js"></script>



    <script src="/javascripts/footer.js"></script>

    <link href="https://fonts.googleapis.com/css?family=Alegreya+Sans|EB+Garamond|Encode+Sans+Expanded|Inconsolata|Karla|Manuale|Nunito+Sans|Pontano+Sans|Roboto+Slab:300|Rokkitt|Sanchez" rel="stylesheet">
</head>

<body>

<div class="header">

    <div id="nav"></div>
    <div class="nav-left">
        <a href="/home">Home</a>
        <a href="/contact">Contact</a>

        <% if (isAuthenticated) { %>
            <a href="/profile">Profile</a>

            <form method="POST" action="/logout" style="display:inline;">
                <button type="submit">Logout</button>
            </form>
        <% } else { %>
            <a href="/login">Log in / Register</a>
        <% } %>
    </div>

</div>

<div class="front-page">

    <!-- Fiction Section -->
    <div class="book-section">
        <h1>New York Times Best Sellers: Fiction</h1>

        <div class="book-grid">
            <% if (books && books.length) { %>
                <% books.forEach(function(b) { %>

                    <a href="/book_profile/<%= encodeURIComponent(b.title) %>&<%= encodeURIComponent(b.author) %>">
                        <img class="book-image"
                             src="<%= b.book_image %>"
                             alt="<%= b.title %>">
                    </a>

                <% }) %>
            <% } else { %>
                <p>No fiction books available.</p>
            <% } %>
        </div>
    </div>


    <!-- Non-Fiction Section -->
    <div class="book-section">
        <h1>New York Times Best Sellers: Non-Fiction</h1>

        <div class="book-grid">
            <% if (nf_books && nf_books.length) { %>
                <% nf_books.forEach(function(a) { %>

                    <a href="/book_profile/<%= encodeURIComponent(a.title) %>&<%= encodeURIComponent(a.author) %>">
                        <img class="book-image"
                             src="<%= a.book_image %>"
                             alt="<%= a.title %>">
                    </a>

                <% }) %>
            <% } else { %>
                <p>No nonfiction books available.</p>
            <% } %>
        </div>
    </div>

</div>

<div id="footer"></div>



</body>
</html>